{
  "name": "impulso-ai-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "npm run build -w @impulso/contracts && npm run build -w @impulso/api && npm run build -w @impulso/web",
    "dev:api": "npm run start:dev -w @impulso/api",
    "dev:web": "npm run start -w @impulso/web",
    "test": "npm run test -w @impulso/api",
    "typecheck": "npm run typecheck -w @impulso/contracts && npm run typecheck -w @impulso/api",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,html,scss,json}\"",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "supabase": "^2.34.3",
    "typescript": "~6.0.2"
  },
  "engines": { "node": ">=22" }
}
