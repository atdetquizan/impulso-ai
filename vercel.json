{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.frontend"
    },
    "api": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.api"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}