# Backend Supabase settings (none are compiled into Angular)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY

# AI provider: cloudflare (recommended) or openai
AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_WORKERS_AI_TOKEN
CLOUDFLARE_TEXT_MODEL=@cf/google/gemma-4-26b-a4b-it
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_STEPS=4
CLOUDFLARE_TEXT_MAX_COMPLETION_TOKENS=2400
CLOUDFLARE_REASONING_EFFORT=low

# Optional: only required when AI_PROVIDER=openai
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_TEXT_MODEL=gpt-5.6
OPENAI_IMAGE_MODEL=gpt-image-2
TOKEN_ENCRYPTION_KEY=BASE64_ENCODED_32_BYTE_KEY
TIKTOK_CLIENT_KEY=YOUR_TIKTOK_CLIENT_KEY
TIKTOK_CLIENT_SECRET=YOUR_TIKTOK_CLIENT_SECRET
TIKTOK_REDIRECT_URI=http://localhost:4200/settings/tiktok/callback
# Necesario para redirect URI localhost (TikTok Desktop Login Kit)
TIKTOK_PKCE_ENABLED=true
FRONTEND_URL=http://localhost:4200
# Déjalo en false para HTTP local. En HTTPS se detecta automáticamente si se omite.
AUTH_COOKIE_SECURE=false
PORT=3000
SCHEDULER_ENABLED=true
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
AUTH_MAGIC_LINK_COOLDOWN_SECONDS=60
AUTH_MAGIC_LINK_TTL_MINUTES=15
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
# Genera uno con: openssl rand -base64 48
AUTH_TOKEN_SECRET=REEMPLAZA_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES

# SMTP para Magic Links enviados por NestJS (no se compila en Angular)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_cuenta@gmail.com
SMTP_PASS=TU_CONTRASENA_DE_APLICACION
EMAIL_FROM="Impulso IA <tu_cuenta@gmail.com>"
